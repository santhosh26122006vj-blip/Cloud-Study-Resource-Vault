rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email.matches('.*admin.*')
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /resources/{resourceId} {
      // Any signed-in student/admin can browse resources.
      allow read: if isAuthenticated();

      // Students can upload their own resources. Admins can upload on behalf of the vault.
      // fileData is Base64 and is intentionally capped so the Firestore document stays below 1 MiB.
      allow create: if isAuthenticated()
        && request.resource.data.title is string
        && request.resource.data.subject is string
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.fileName is string
        && (
          !('fileData' in request.resource.data) ||
          request.resource.data.fileData == null ||
          (request.resource.data.fileData is string && request.resource.data.fileData.size() <= 1000000)
        );

      // Admins manage everything. Students can update/delete only their own resources.
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.uploadedBy == request.auth.uid &&
        request.resource.data.uploadedBy == resource.data.uploadedBy &&
        (
          !('fileData' in request.resource.data) ||
          request.resource.data.fileData == null ||
          (request.resource.data.fileData is string && request.resource.data.fileData.size() <= 1000000)
        )
      );

      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uploadedBy == request.auth.uid);
    }

    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
  }
}
